# mimo-usage 环境变量示例（复制为 .env，或直接注入进程环境）
#
# 配置三源与优先级：
#   - 运行参数（server/upstream/cache/reauth）：环境变量 > config.yaml > 默认值
#   - 凭证：MIMO_<NAME>_FILE 文件 > MIMO_<NAME> 内联 > config.yaml 的 credentials.<key>
#     （即：一旦设了 *_FILE，该字段以文件为准，内联值只作兜底）
# config.yaml 由 MIMO_CONFIG 指定；./run.sh 在 ./config.yaml 存在时会自动导出它。

# ---- 配置文件（可选）----
# MIMO_CONFIG=./config.yaml

# ---- 上游 ----
# platform.xiaomimimo.com（用量 API 基址）
MIMO_BASE_URL=https://platform.xiaomimimo.com
# account.xiaomi.com（serviceLoginAuth2 / 续登）
MIMO_ACCOUNT_BASE_URL=https://account.xiaomi.com
MIMO_SID=api-platform
MIMO_REQUEST_TIMEOUT=15
MIMO_CONNECT_TIMEOUT=5
MIMO_MAX_CONNECTIONS=32
MIMO_MAX_KEEPALIVE_CONNECTIONS=16
MIMO_RETRIES=2
MIMO_RETRY_BACKOFF=0.3

# ---- 服务 ----
MIMO_HOST=0.0.0.0
MIMO_PORT=8000
MIMO_WORKERS=1
MIMO_DEBUG=false
MIMO_ACCESS_LOG=true
MIMO_DASHBOARD_PATH=/dashboard
MIMO_DASHBOARD_REFRESH_SECONDS=30
# 看板/API 访问密钥（留空 = 不鉴权；公网部署务必设置）
MIMO_API_KEY=

# ---- 缓存 ----
MIMO_USAGE_TTL=300
MIMO_DETAIL_TTL=600
MIMO_BILL_TTL=3600
MIMO_TOKEN_PLAN_TTL=600
MIMO_ACCOUNT_TTL=3600
MIMO_STALE_TTL=600
MIMO_CACHE_MAX_ENTRIES=256
MIMO_REFRESH_MIN_INTERVAL=30
MIMO_SUMMARY_MAX_AGE=300
MIMO_DEFAULT_USAGE_DAYS=7
MIMO_MAX_RANGE_DAYS=366

# ---- 续登冷却 ----
# 免密续登失败冷却（秒）
MIMO_REAUTH_COOLDOWN=300
# 密码登录失败/验证码冷却（秒，防风控连击）
MIMO_PASSWORD_REAUTH_COOLDOWN=3600

# ---- 凭证（内联 或 *_FILE，二选一；也可放 config.yaml credentials.*）----
# 平台会话 Cookie：api-platform_serviceToken 的值（可从浏览器复制，含引号可保留）
MIMO_SERVICE_TOKEN=
MIMO_SERVICE_TOKEN_FILE=./secrets/serviceToken
# 自动续登用：account 域 passToken 与设备 id（浏览器 Cookie 里复制）
MIMO_PASS_TOKEN=
MIMO_PASS_TOKEN_FILE=./secrets/passToken
MIMO_DEVICE_ID=
MIMO_DEVICE_ID_FILE=./secrets/deviceId
# /sts 下发的伴随字段（续登成功会自动回写；也可预填）
MIMO_USER_ID=
MIMO_USER_ID_FILE=./secrets/userId
MIMO_PH=
MIMO_PH_FILE=./secrets/ph
MIMO_SLH=
MIMO_SLH_FILE=./secrets/slh

# ---- 密码续登材料（可选；免密根失效时兜底）----
# 登录账号：手机号或 uid，不带 +86
MIMO_USERNAME=
MIMO_USERNAME_FILE=./secrets/username
# 浏览器登录时的设备指纹（FingerprintJS visitorId，密码续登必填）
MIMO_DEVICE_FINGERPRINT=
MIMO_DEVICE_FINGERPRINT_FILE=./secrets/deviceFingerprint
# 明文密码只读取一次：转为 passwordMd5/passwordBcrypt 写入 config.yaml，不落明文
MIMO_PASSWORD=
# 或直接提供 MD5(密码) 大写
MIMO_PASSWORD_HASH=
MIMO_PASSWORD_HASH_FILE=./secrets/passwordMd5
